{
  "name": "beerify",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "check": "npm run lint && tsc -b && tsc -p api/tsconfig.json --noEmit && npm test && npm run ios:check",
    "test": "tsx --test src/lib/bac.test.ts src/lib/storage.test.ts api/apns.test.ts",
    "e2e": "node scripts/e2e-check.mjs",
    "e2e:rooms": "node scripts/e2e-rooms.mjs",
    "expo:go": "powershell -ExecutionPolicy Bypass -File scripts/expo-go.ps1",
    "ios:sync": "npm run build && cap sync ios && node scripts/fix-ios-paths.mjs",
    "ios:check": "node scripts/check-ios.mjs",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fontsource-variable/archivo": "^5.2.8",
    "@supabase/supabase-js": "^2.110.2",
    "@upstash/redis": "^1.38.0",
    "@vercel/functions": "^3.7.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
