VITE_API_BASE_URL=https://beerify-lime.vercel.app
VITE_PUBLIC_APP_URL=https://beerify-lime.vercel.app
VITE_APNS_ENVIRONMENT=sandbox

# Public browser map style. Restrict its provider key to your deployed origins.
VITE_MAP_STYLE_URL=

# Set this as an encrypted Vercel environment variable for town/postcode search.
MAPTILER_API_KEY=

# Optional account sync
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set these as encrypted Vercel environment variables, never as VITE_ values.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_TOPIC=app.beerify.mobile
